# --- Database (swap to postgresql:// for production) ---
DATABASE_URL="file:./dev.db"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# --- Code judge ---
# auto  -> use Docker when the daemon is reachable, otherwise local subprocess
# docker-> always use Docker (fail if unavailable)
# local -> always use local subprocess runner
JUDGE_MODE=auto
# Optional: pin the docker CLI when it is not on PATH
# DOCKER_BIN="C:/Program Files/Docker/Docker/resources/bin/docker.exe"
JUDGE_WORKDIR=../judge-work
JUDGE_MAX_CODE_BYTES=20000
JUDGE_COMPILE_TIMEOUT_MS=15000
